# Copy to .env for local dev. Compose injects the service-host overrides.
APP_NAME=CHOLAVIN-ERP
ENV=dev
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

# Owner/superuser role — migrations & role bootstrap only.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cholavin
POSTGRES_USER=cholavin
POSTGRES_PASSWORD=cholavin

# Runtime app role — NOSUPERUSER so RLS applies. Created by migration 0002;
# if you change APP_DB_PASSWORD, update the password in 0002_app_role.py too.
APP_DB_USER=cholavin_app
APP_DB_PASSWORD=cholavin_app

REDIS_URL=redis://redis:6379/0
MONGO_URL=mongodb://mongo:27017
MONGO_DB=cholavin

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
